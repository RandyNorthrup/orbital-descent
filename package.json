{
  "name": "orbital-descent",
  "version": "0.1.0",
  "private": true,
  "description": "A modern 2D landing-and-exploration game across fictional worlds, built with Phaser 4 and TypeScript.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "security:audit": "pnpm audit --prod",
    "security:secrets": "secretlint \"**/*\" --secretlintignore .gitignore",
    "deadcode": "knip",
    "bundle:analyze": "vite-bundle-visualizer",
    "lighthouse": "lhci autorun",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm deadcode && pnpm security:secrets",
    "quality:full": "pnpm quality && pnpm security:audit && pnpm test:e2e"
  },
  "dependencies": {
    "phaser": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "knip": "6.24.0",
    "prettier": "3.9.4",
    "secretlint": "13.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vite-bundle-visualizer": "1.2.1",
    "vitest": "4.1.9"
  }
}
